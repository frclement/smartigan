            "We", " ", "cannot", " ", "move", " ", "a", " ", "point", " ", 
             "if", " ", 
             RowBox[{"it", "'"}], "s", " ", "the", " ", "only", " ", "one", " ",
              "in", " ", "its", " ", "cluster"}], "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"counts", "[", 
               RowBox[{"[", "l", "]"}], "]"}], ">", "1"}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "Calculate", " ", "Delta", " ", "for", " ", "current", " ", 
               "cluster", " ", "L"}], "*)"}], 
             RowBox[{
              RowBox[{"deltaL", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "-", "1.0"}], ")"}]}], 
                 ")"}], "*", 
                RowBox[{"Total", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], ")"}], "^", "2"}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Find", " ", "the", " ", "best", " ", "alternative", " ", 
                "cluster", " ", "M"}], "*)"}], 
              RowBox[{"minDelta", "=", "Infinity"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"bestM", "=", "l"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"m", "!=", "l"}], ",", 
                  RowBox[{
                   RowBox[{"deltaM", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "+", "1.0"}], ")"}]}], 
                    ")"}], "*", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}], ")"}], "^", "2"}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"deltaM", "<", "  ", "minDelta"}], ",", 
                    RowBox[{
                    RowBox[{"minDelta", "=", "deltaM"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"bestM", "=", "m"}], ";"}]}], "]"}], ";"}]}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "k"}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"4.", " ", "Transfer", " ", 
                RowBox[{"Step", ":", 
                 RowBox[{
                 "If", " ", "moving", " ", "to", " ", "M", " ", "reduces", " ",
                   "SSE"}]}]}], "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minDelta", "<", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1.5", "-", 
                    RowBox[{"0.5", 
                    RowBox[{"(", 
                    RowBox[{"iter", "/", "maxIters"}], ")"}]}]}], ")"}], "  ",
                   "deltaL"}]}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Update", " ", "Centroids"}], "*)"}], 
                RowBox[{
                 RowBox[{
                  RowBox[{"centroids", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "*", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], "-", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "-", "1"}], ")"}]}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"centroids", "[", 
                   RowBox[{"[", "bestM", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}], "*", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}]}], "+", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}], "+", "1"}], ")"}]}]}],
                  ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Update", " ", "Counts", " ", "and", " ", "Assignment"}], 
                  "*)"}], 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "--"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "bestM", "]"}], "]"}], "++"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"assignments", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "=", "bestM"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"changed", "=", "True"}], ";"}]}], "]"}], ";"}]}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Assignments\>\"", "->", "assignments"}], ",", 
       RowBox[{"\"\<Centroids\>\"", "->", "centroids"}], ",", 
       RowBox[{"\"\<Iterations\>\"", "->", "iter"}]}], "|>"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.984563157493379*^9, 3.984563177420644*^9}, {
  3.984563254094648*^9, 3.984563269464655*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"4dee0306-f9f8-4f9a-b25a-6503e49845a7"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.98456299171424*^9, 
  3.984562991967605*^9}},ExpressionUUID->"809f6a70-cc12-4856-bcd2-\
c6e8b01b7fd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testData", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"MultinormalDistribution", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", "2000"}], 
      "]"}], ",", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"MultinormalDistribution", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", "2000"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.984563112051303*^9, 3.984563115324677*^9}, {
  3.9845633182428102`*^9, 3.984563320683769*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"d7bf6c36-4272-412f-be77-469e907edfce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"HartiganWongKMeans", "[", 
    RowBox[{"testData", ",", "2"}], "]"}]}], ";", 
  RowBox[{"cl1", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "1"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"cl2", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "2"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"m1", "=", 
   RowBox[{"Mean", "[", "cl1", "]"}]}], ";", 
  RowBox[{"m2", "=", 
   RowBox[{"Mean", "[", "cl2", "]"}]}], ";", " ", 
  RowBox[{"{", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"cl1", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "m1"}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cl1", "]"}]}], "}"}]}], "]"}], "+", "  ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"cl2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "m2"}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cl2", "]"}]}], "}"}]}], "]"}]}], ",", " ", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"{", 
      RowBox[{"cl1", ",", "cl2"}], "}"}], "]"}]}], "}"}]}]], "Input",

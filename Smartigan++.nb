  3.984565257514194*^9}},ExpressionUUID->"526c072e-9b00-42f0-9de5-\
e953905cf129"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testData", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"MultinormalDistribution", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", "20", "}"}]}], "]"}], ",", 
       RowBox[{"IdentityMatrix", "[", "20", "]"}]}], "]"}], ",", "2000"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.984563112051303*^9, 3.984563115324677*^9}, {
  3.9845633182428102`*^9, 3.984563320683769*^9}, {3.9845652635112743`*^9, 
  3.984565271779825*^9}, {3.984565544259369*^9, 3.984565562360258*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"18dc4ef2-6ebe-47f5-850d-d59467a34927"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"HartiganWongKMeans", "[", 
    RowBox[{"testData", ",", "20"}], "]"}]}], ";", 
  RowBox[{"cl1", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "1"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"cl2", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "2"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"m1", "=", 
   RowBox[{"Mean", "[", "cl1", "]"}]}], ";", 
  RowBox[{"m2", "=", 
   RowBox[{"Mean", "[", "cl2", "]"}]}], ";", " ", 
  RowBox[{"{", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{

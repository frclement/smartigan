Cell[BoxData[
 RowBox[{
  RowBox[{"HartiganWongKMeans", "[", 
   RowBox[{"data_List", ",", "k_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "data", "]"}]}], ",", 
      RowBox[{"dims", "=", 
       RowBox[{"Last", "@", 
        RowBox[{"Dimensions", "[", "data", "]"}]}]}], ",", "assignments", ",",
       "counts", ",", "centroids", ",", "sse", ",", 
      RowBox[{"changed", "=", "True"}], ",", 
      RowBox[{"iter", "=", "1"}], ",", "i", ",", "l", ",", "m", ",", "bestM", 
      ",", "minDelta", ",", "deltaL", ",", "deltaM"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"1.", " ", "Initial", " ", "Assignment", " ", 
      RowBox[{"(", "Random", ")"}]}], "*)"}], 
    RowBox[{
     RowBox[{"assignments", "=", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "k"}], "}"}], ",", "n"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Initial", " ", "Centroids", " ", "and", " ", "Counts"}], 
      "*)"}], 
     RowBox[{"counts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"assignments", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "k"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"centroids", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"counts", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ">", "0"}], ",", 
          RowBox[{"Mean", "[", 
           RowBox[{"Extract", "[", 
            RowBox[{"data", ",", 
             RowBox[{"Position", "[", 
              RowBox[{"assignments", ",", "j"}], "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "n"}], "}"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "k"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"3.", " ", "Main", " ", "Loop"}], "*)"}], 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"changed", "&&", 
        RowBox[{"iter", "<=", "10"}]}], ",", 
       RowBox[{
        RowBox[{"changed", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"iter", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"l", "=", 
            RowBox[{"assignments", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "We", " ", "cannot", " ", "move", " ", "a", " ", "point", " ", 
             "if", " ", 
             RowBox[{"it", "'"}], "s", " ", "the", " ", "only", " ", "one", " ",
              "in", " ", "its", " ", "cluster"}], "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"counts", "[", 
               RowBox[{"[", "l", "]"}], "]"}], ">", "1"}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "Calculate", " ", "Delta", " ", "for", " ", "current", " ", 
               "cluster", " ", "L"}], "*)"}], 
             RowBox[{
              RowBox[{"deltaL", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "-", "1.0"}], ")"}]}], 
                 ")"}], "*", 
                RowBox[{"Total", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], ")"}], "^", "2"}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Find", " ", "the", " ", "best", " ", "alternative", " ", 
                "cluster", " ", "M"}], "*)"}], 
              RowBox[{"minDelta", "=", "Infinity"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"bestM", "=", "l"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"m", "!=", "l"}], ",", 
                  RowBox[{
                   RowBox[{"deltaM", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "+", "1.0"}], ")"}]}], 
                    ")"}], "*", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}], ")"}], "^", "2"}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"deltaM", "<", "minDelta"}], ",", 
                    RowBox[{
                    RowBox[{"minDelta", "=", "deltaM"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"bestM", "=", "m"}], ";"}]}], "]"}], ";"}]}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "k"}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"4.", " ", "Transfer", " ", 
                RowBox[{"Step", ":", 
                 RowBox[{
                 "If", " ", "moving", " ", "to", " ", "M", " ", "reduces", " ",
                   "SSE"}]}]}], "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minDelta", "<", "deltaL"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Update", " ", "Centroids"}], "*)"}], 
                RowBox[{
                 RowBox[{
                  RowBox[{"centroids", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "*", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], "-", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "-", "1"}], ")"}]}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"centroids", "[", 
                   RowBox[{"[", "bestM", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}], "*", 
                    RowBox[{"centroids", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}]}], "+", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"counts", "[", 
                    RowBox[{"[", "bestM", "]"}], "]"}], "+", "1"}], ")"}]}]}],
                  ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Update", " ", "Counts", " ", "and", " ", "Assignment"}], 
                  "*)"}], 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], "--"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"counts", "[", 
                   RowBox[{"[", "bestM", "]"}], "]"}], "++"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"assignments", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "=", "bestM"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"changed", "=", "True"}], ";"}]}], "]"}], ";"}]}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Assignments\>\"", "->", "assignments"}], ",", 
       RowBox[{"\"\<Centroids\>\"", "->", "centroids"}], ",", 
       RowBox[{"\"\<Iterations\>\"", "->", "iter"}]}], "|>"}]}]}], 
   "]"}]}]], "Input",

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"ModHart2", "[", 
    RowBox[{"testData", ",", "2", ",", "10", ",", 
     RowBox[{"result", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"cl1", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "1"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"cl2", "=", 
   RowBox[{"testData", "[", 
    RowBox[{"[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"result", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"result", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "#"}], "]"}], "]"}], "==", "2"}], "&"}]}], "]"}],
      "]"}], "]"}]}], ";", 
  RowBox[{"m1", "=", 
   RowBox[{"Mean", "[", "cl1", "]"}]}], ";", 
  RowBox[{"m2", "=", 
   RowBox[{"Mean", "[", "cl2", "]"}]}], ";", " ", 
  RowBox[{"{", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"cl1", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "m1"}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cl1", "]"}]}], "}"}]}], "]"}], "+", "  ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"cl2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "m2"}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cl2", "]"}]}], "}"}]}], "]"}]}], ",", " ", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"{", 
      RowBox[{"cl1", ",", "cl2"}], "}"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.984563141887416*^9, 3.984563146228574*^9}, {
